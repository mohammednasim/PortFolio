# ---- API server ----
PORT=8787
NODE_ENV=development
HOST=0.0.0.0
TRUST_PROXY=false
LOG_LEVEL=debug
DB_FILE=data/portfolio.db

# Comma separated list of origins allowed to call the API.
# Leave empty in development to allow any localhost / 127.0.0.1 port.
# In production set it to your real domain, e.g. https://nasim.dev
CORS_ORIGINS=

# ---- Contact form email (optional) ----
# When these are empty, messages are still validated and stored in SQLite,
# they are just not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM="Mohammed Nasim P <no-reply@example.com>"
CONTACT_TO=nasimparammel@gmail.com

# ---- Portfolio AI assistant (optional) ----
# Without a key the assistant still works using the built-in knowledge engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000

# ---- Owner dashboard (optional) ----
# Set a long random string to enable GET /api/admin/messages (x-admin-token header).
ADMIN_TOKEN=
